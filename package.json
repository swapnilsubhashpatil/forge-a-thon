{
  "name": "anvil",
  "displayName": "Anvil: TrueForge Coding Agent",
  "description": "Agentic coding inside VS Code, orchestrated by the TrueForge harness.",
  "version": "0.1.0",
  "publisher": "anvil-forge",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/swapnilsubhashpatil/forge-a-thon"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22.18.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "anvil",
          "title": "Anvil",
          "icon": "media/anvil.svg"
        }
      ]
    },
    "views": {
      "anvil": [
        {
          "type": "webview",
          "id": "anvil.chat",
          "name": "Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "anvil.inlineEdit",
        "title": "Edit Selection with Anvil",
        "category": "Anvil",
        "icon": "$(sparkle)"
      },
      {
        "command": "anvil.newSession",
        "title": "New Session",
        "category": "Anvil",
        "icon": "$(add)"
      },
      {
        "command": "anvil.showHistory",
        "title": "Show Chat History",
        "category": "Anvil",
        "icon": "$(history)"
      },
      {
        "command": "anvil.showSettings",
        "title": "Show Anvil Settings",
        "category": "Anvil",
        "icon": "$(settings-gear)"
      },
      {
        "command": "anvil.cancel",
        "title": "Cancel Running Turn",
        "category": "Anvil",
        "icon": "$(debug-stop)"
      },
      {
        "command": "anvil.acceptHunk",
        "title": "Accept Change",
        "category": "Anvil"
      },
      {
        "command": "anvil.rejectHunk",
        "title": "Reject Change",
        "category": "Anvil"
      },
      {
        "command": "anvil.acceptAll",
        "title": "Accept All Changes in File",
        "category": "Anvil",
        "icon": "$(check-all)"
      },
      {
        "command": "anvil.rejectAll",
        "title": "Reject All Changes in File",
        "category": "Anvil",
        "icon": "$(close-all)"
      },
      {
        "command": "anvil.nextChange",
        "title": "Go to Next Agent Change",
        "category": "Anvil",
        "icon": "$(arrow-down)"
      },
      {
        "command": "anvil.prevChange",
        "title": "Go to Previous Agent Change",
        "category": "Anvil",
        "icon": "$(arrow-up)"
      },
      {
        "command": "anvil.keepAll",
        "title": "Keep All Agent Changes",
        "category": "Anvil",
        "icon": "$(check-all)"
      },
      {
        "command": "anvil.discardAll",
        "title": "Discard All Agent Changes",
        "category": "Anvil",
        "icon": "$(discard)"
      },
      {
        "command": "anvil.undoLastChange",
        "title": "Undo Last Agent Change",
        "category": "Anvil",
        "icon": "$(discard)"
      },
      {
        "command": "anvil.openSessionInHarness",
        "title": "Open Session in TrueForge",
        "category": "Anvil",
        "icon": "$(link-external)"
      },
      {
        "command": "anvil.selectModels",
        "title": "Configure Model Fallback Chain",
        "category": "Anvil"
      },
      {
        "command": "anvil.restartHarness",
        "title": "Reconnect to TrueForge",
        "category": "Anvil"
      },
      {
        "command": "anvil.addSelectionToChat",
        "title": "Add Selection to Anvil Chat",
        "category": "Anvil",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "anvil.addTerminalSelectionToChat",
        "title": "Add Terminal Selection to Anvil Chat",
        "category": "Anvil"
      },
      {
        "command": "anvil.addTerminalOutputToChat",
        "title": "Add Last Terminal Command to Anvil Chat",
        "category": "Anvil"
      },
      {
        "command": "anvil.askAboutSelection",
        "title": "Ask Anvil About Selection",
        "category": "Anvil",
        "icon": "$(comment-discussion)"
      }
    ],
    "keybindings": [
      {
        "command": "anvil.inlineEdit",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "workspaceFolderCount > 0 && editorTextFocus"
      },
      {
        "command": "anvil.acceptHunk",
        "key": "ctrl+alt+y",
        "mac": "cmd+alt+y",
        "when": "anvil.editorUnderReview && editorTextFocus"
      },
      {
        "command": "anvil.rejectHunk",
        "key": "ctrl+alt+x",
        "mac": "cmd+alt+x",
        "when": "anvil.editorUnderReview && editorTextFocus"
      },
      {
        "command": "anvil.nextChange",
        "key": "alt+f5",
        "mac": "alt+f5",
        "when": "anvil.editorUnderReview && editorTextFocus"
      },
      {
        "command": "anvil.prevChange",
        "key": "shift+alt+f5",
        "mac": "shift+alt+f5",
        "when": "anvil.editorUnderReview && editorTextFocus"
      },
      {
        "command": "anvil.cancel",
        "key": "ctrl+alt+backspace",
        "mac": "cmd+alt+backspace",
        "when": "anvil.turnRunning"
      },
      {
        "command": "anvil.addSelectionToChat",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "workspaceFolderCount > 0 && editorTextFocus"
      },
      {
        "command": "anvil.addTerminalSelectionToChat",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "workspaceFolderCount > 0 && terminalFocus && terminalTextSelected"
      },
      {
        "command": "anvil.addTerminalOutputToChat",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "workspaceFolderCount > 0 && terminalFocus && !terminalTextSelected"
      },
      {
        "command": "anvil.askAboutSelection",
        "key": "ctrl+alt+q",
        "mac": "cmd+alt+q",
        "when": "workspaceFolderCount > 0 && editorTextFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "anvil.newSession",
          "when": "view == anvil.chat",
          "group": "navigation@1"
        },
        {
          "command": "anvil.showHistory",
          "when": "view == anvil.chat",
          "group": "navigation@2"
        },
        {
          "command": "anvil.showSettings",
          "when": "view == anvil.chat",
          "group": "navigation@3"
        },
        {
          "command": "anvil.openSessionInHarness",
          "when": "view == anvil.chat",
          "group": "navigation@4"
        }
      ],
      "editor/title": [
        {
          "command": "anvil.acceptAll",
          "when": "anvil.editorUnderReview",
          "group": "navigation@1"
        },
        {
          "command": "anvil.rejectAll",
          "when": "anvil.editorUnderReview",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "anvil.askAboutSelection",
          "when": "workspaceFolderCount > 0 && editorHasSelection",
          "group": "1_modification@0"
        },
        {
          "command": "anvil.inlineEdit",
          "when": "workspaceFolderCount > 0 && editorHasSelection",
          "group": "1_modification@0"
        },
        {
          "command": "anvil.addSelectionToChat",
          "when": "workspaceFolderCount > 0 && editorHasSelection",
          "group": "1_modification@1"
        }
      ],
      "terminal/context": [
        {
          "command": "anvil.addTerminalSelectionToChat",
          "when": "workspaceFolderCount > 0 && terminalTextSelected",
          "group": "anvil@1"
        },
        {
          "command": "anvil.addTerminalOutputToChat",
          "group": "anvil@2",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "commandPalette": [
        {
          "command": "anvil.acceptHunk",
          "when": "anvil.reviewActive"
        },
        {
          "command": "anvil.rejectHunk",
          "when": "anvil.reviewActive"
        },
        {
          "command": "anvil.acceptAll",
          "when": "anvil.reviewActive"
        },
        {
          "command": "anvil.rejectAll",
          "when": "anvil.reviewActive"
        },
        {
          "command": "anvil.nextChange",
          "when": "anvil.reviewActive"
        },
        {
          "command": "anvil.prevChange",
          "when": "anvil.reviewActive"
        }
      ]
    },
    "configuration": {
      "title": "Anvil",
      "properties": {
        "anvil.harness.url": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "Base URL of the TrueForge harness server.",
          "scope": "machine"
        },
        "anvil.harness.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start a local TrueForge server with npx when none is reachable.",
          "scope": "machine"
        },
        "anvil.models.chain": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Ordered model fallback chain, as TrueForge model names (`provider/model`). The first healthy model runs each turn; failures fall through to the next."
        },
        "anvil.context.budgetTokens": {
          "type": "number",
          "default": 6000,
          "minimum": 1000,
          "description": "Token budget for the context pack attached to each turn."
        },
        "anvil.review.mode": {
          "type": "string",
          "enum": [
            "review",
            "applyThenReview"
          ],
          "default": "review",
          "enumDescriptions": [
            "Review each change in the editor before it is written",
            "Apply changes at once; keep or undo them afterwards from the Changes tray"
          ],
          "description": "How agent edits reach your files."
        },
        "anvil.resilience.firstEventTimeoutSeconds": {
          "type": "number",
          "default": 45,
          "minimum": 5,
          "description": "Fail over to the next model when no model output arrives within this many seconds."
        },
        "anvil.agent.iterationLimit": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 1024,
          "description": "Maximum agent loop iterations per turn."
        },
        "anvil.agent.promptProfile": {
          "type": "string",
          "enum": [
            "auto",
            "full",
            "compact"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Compact prompt for local ollama/ models, full prompt otherwise",
            "Always use the full agent prompt",
            "Always use the short prompt (helps small or weak models)"
          ],
          "description": "Which agent instructions to send. The compact prompt is shorter and easier for small models to follow."
        },
        "anvil.commands.timeoutSeconds": {
          "type": "number",
          "default": 120,
          "description": "Timeout for commands the agent runs."
        },
        "anvil.commands.autoApprove": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Command prefixes the agent may run without asking, for example `npm test` or `pytest`. Commands that chain or redirect (`;`, `&&`, `|`, `>`) always ask."
        },
        "anvil.models.reasoningEffort": {
          "type": "string",
          "enum": [
            "default",
            "none",
            "low",
            "medium",
            "high"
          ],
          "default": "default",
          "markdownDescription": "Reasoning effort passed to the model. `none` disables thinking on models such as Qwen 3, which makes local models much faster. With `default`, `ollama/` models get `none` and hosted models keep their own default."
        },
        "anvil.selection.askActions": {
          "type": "boolean",
          "default": true,
          "description": "Show the “Ask Anvil about this” lightbulb action and hover link on selected code."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && vite build --config webview-ui/vite.config.ts",
    "watch": "node scripts/build.mjs --watch",
    "watch:webview": "vite build --watch --config webview-ui/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p webview-ui/tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "bench": "node scripts/bench.ts",
    "harness": "node scripts/start-harness.mjs",
    "package": "npm run build && vsce package --no-dependencies --out dist/anvil.vsix",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@truefoundry/trueforge-sdk": "0.185.0",
    "diff": "^9.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/vscode": "~1.95.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
